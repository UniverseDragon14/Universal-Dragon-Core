# ============ Carry-On core configuration ============
# Copy to .env and source it, or export these in your shell / systemd unit.
# Diagnostics: CARRYON_LOG_LEVEL = debug | info | warn | error

# ---- WhatsApp Voice Engine ----
CARRYON_SPOOL="./carryon/spool/whatsapp"
CARRYON_POLL_SECONDS="1.0"

# STT backend: whisper_cpp | faster_whisper | stub
CARRYON_STT_BACKEND="stub"
# WHISPER_CPP_BIN="whisper-cpp"
# WHISPER_CPP_MODEL="models/ggml-base.bin"
# FASTER_WHISPER_MODEL="base"

# TTS backend: piper | espeak | stub
CARRYON_TTS_BACKEND="stub"
# PIPER_BIN="piper"
# PIPER_MODEL="models/en_US-amy-medium.onnx"
# ESPEAK_VOICE="en"

# LLM backend: gemini | http | echo
CARRYON_LLM_BACKEND="echo"
# GEMINI_API_KEY="MY_GEMINI_API_KEY"     # matches repo root .env.example
# GEMINI_MODEL="gemini-2.0-flash"
# CARRYON_LLM_URL="http://127.0.0.1:11434/api/chat"   # Ollama-compatible
# CARRYON_LLM_MODEL="llama3.2"

# Node bridge: only react to these chat ids (comma-separated). Empty = all.
# CARRYON_WA_ALLOW="123456789@s.whatsapp.net"

# ---- Carry-On Gateway ----
# Provide a strong secret (shared by server and client). NEVER commit the real one.
CARRYON_GATEWAY_SECRET="change-me-to-a-long-random-string"
# CARRYON_GATEWAY_KEYFILE="/data/data/com.termux/files/home/.carryon/gateway.key"
CARRYON_GATEWAY_SOCK="/tmp/carryon-gateway.sock"
# To use loopback TCP instead of a unix socket (loopback ONLY, enforced):
# CARRYON_GATEWAY_HOST="127.0.0.1"
# CARRYON_GATEWAY_PORT="8787"
CARRYON_GATEWAY_TS_WINDOW="30"
# CARRYON_BIN_DIR="./carryon/bin"
