[Unit]
Description=UD Terminal local-only web terminal for Pi5
Documentation=https://github.com/UniverseDragon14/Universal-Dragon-Core
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ttyd -i 127.0.0.1 -p 7681 -W /bin/bash -l
Restart=on-failure
RestartSec=3

# Security posture: local-only listener. Use Tailscale Serve for private tailnet access.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
