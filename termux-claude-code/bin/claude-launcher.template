#!/data/data/com.termux/files/usr/bin/bash
# Termux-side launcher for Claude Code running inside proot-distro/@@DISTRO@@.
# Installed to $PREFIX/bin/claude by install.sh. It binds your current Termux
# directory into the distro at the SAME path, so `claude` sees your real files
# and edits land back in Termux storage — no copying.
#
# Everything just works like normal:  cd ~/my-project && claude
set -euo pipefail

DISTRO="@@DISTRO@@"
WORKDIR="$(pwd)"

# Pass through common auth/config env so login + API keys survive the jump.
PASS_ENV=""
for v in ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN HTTPS_PROXY HTTP_PROXY NO_PROXY; do
  if [ -n "${!v:-}" ]; then
    PASS_ENV="$PASS_ENV $v=$(printf '%q' "${!v}")"
  fi
done

# --bind "$WORKDIR:$WORKDIR" makes the same path exist inside the distro.
# --bind the Termux home too so ~/.claude config persists across sessions.
exec proot-distro login "$DISTRO" \
  --bind "$WORKDIR:$WORKDIR" \
  --bind "$HOME:$HOME" \
  -- bash -lc "cd $(printf '%q' "$WORKDIR") && env $PASS_ENV claude $(printf '%q ' "$@")"
